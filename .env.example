RUNTIME=local
PORT=3000

# Shared secret guarding every /api route except /api/health.
# Leave empty to disable auth (local dev only — never in production).
API_KEY=

# ── WhatsApp ─────────────────────────────────────────
WA_ENABLED=true                      # false = API-only mode, no Chromium needed
WA_SESSION_DATA_PATH=.wwebjs_auth    # LocalAuth session folders live here
WA_DEFAULT_SESSION_ID=default        # session used when a request omits sessionId
WA_QR_MAX_RETRIES=20
WA_AUTH_TIMEOUT_MS=60000

# Point at a system Chrome instead of the bundled Chromium (useful on servers)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Storage ──────────────────────────────────────────
DB_FILE=data/wup.db

# ── Webhooks ─────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
