{
  "name": "wup",
  "version": "1.0.0",
  "description": "WhatsApp bridge — device linking, inbound/outbound messages for groups and individuals, with webhooks",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "cd frontend && npm install && npm run build",
    "db:init": "node scripts/init-db.mjs",
    "db:status": "node scripts/init-db.mjs --status",
    "db:reset": "node scripts/init-db.mjs --reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "webhook",
    "bridge"
  ],
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
